# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5435/cognify"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here

# ── AI Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...                    # https://console.groq.com
OPENAI_API_KEY=sk-...                   # For embeddings (optional, falls back to char-code)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── AWS S3 (optional — uploads will be stored locally if not set) ─────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=cognify-uploads

# ── Stripe (required for billing features) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...              # Monthly price ID for PRO plan
STRIPE_PRICE_ENTERPRISE=price_...      # Monthly price ID for ENTERPRISE plan

# ── Integrations (all optional) ──────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...               # https://api.slack.com/apps

GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

NOTION_API_KEY=secret_...              # https://www.notion.so/my-integrations
